{
  "name": "chatgpt-code-mcp",
  "version": "1.1.0",
  "private": true,
  "description": "Self-hosted MCP server that exposes a sandboxed local code workspace to ChatGPT and other MCP clients",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "mcp:stdio": "tsx src/bin/stdio.ts",
    "mcp:http": "tsx src/bin/http.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bin/http.js",
    "start:stdio": "node dist/bin/stdio.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  }
}
