# Copy to .env and fill in. Never commit the filled-in file.
# `docker compose` reads .env from this directory automatically.

# --- MCP HTTP server ---------------------------------------------------------
# Shared secret for the Streamable HTTP endpoint. Binding 0.0.0.0 without it is
# refused at startup. This token is the only thing standing between the
# internet and your code. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=replace-me-with-32-random-bytes-hex

# Host directory holding your code. It must contain a .code-agent.json.
WORKSPACE_DIR=/srv/code

# Optional: workspace roots when running without Docker, separated by the
# platform path delimiter (':' on Linux). Defaults to the working directory.
# MCP_WORKSPACE_ROOTS=/srv/code

# --- deploy tool -------------------------------------------------------------
# The `deploy` tool runs git and docker on the host, outside the path sandbox.
# It is the one tool that is off by default: it needs exactly "true".
DEPLOY_ENABLED=false

# Git checkout that gets pulled and rebuilt. Under compose the container always
# sees it at /repo, so set the HOST path here.
DEPLOY_HOST_REPO_DIR=.
# Without compose (see deploy/chatgpt-code-mcp.service), set the real path:
# DEPLOY_REPO_DIR=/srv/chatgpt-code-mcp

# Optional: host docker group id, so the non-root container can use
# /var/run/docker.sock. Find it with: getent group docker | cut -d: -f3
DOCKER_GID=999

# Optional: explicit compose file. Empty/unset uses the directory's default.
# DEPLOY_COMPOSE_FILE=/repo/compose.yaml
# Optional: comma-separated services to rebuild and restart. Default: mcp
DEPLOY_SERVICES=mcp
# Optional: hard timeout for the whole deploy, in ms. Default 900000 (15 min).
DEPLOY_TIMEOUT_MS=900000
