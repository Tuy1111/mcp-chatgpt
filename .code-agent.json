{
  "name": "chatgpt-code-mcp-sample",
  "allowedPaths": [
    "src/**",
    "test/**",
    "package.json",
    "tsconfig.json",
    "README.md",
    ".code-agent.json"
  ],
  "blockedPaths": [
    ".env*",
    "secrets/**",
    "**/*.key",
    "**/*.pem",
    "node_modules/**"
  ],
  "commands": {
    "test": "pnpm test",
    "build": "pnpm build",
    "typecheck": "pnpm typecheck"
  },
  "maxFileBytes": 512000,
  "writable": true,
  "commandTimeoutMs": 120000
}
